+/** Merge another role's catalog for cross-role bodies; part assets remain lazy. */
+export async function ensureRolePartRegistry(
+  partSet: PartPackageSet,
+  characterId: number,
+  unit: string | null
+): Promise<void> {
+  const targetRoleId = runtimeRoleId(characterId, unit);
+  const hasRole = partSet.roles.some((entry) =>
+    runtimeRoleId(entry.characterId, entry.unit) === targetRoleId
+  );
+  const hasRegistry = partSet.registry.some((entry) =>
+    runtimeRoleId(entry.characterId, entry.unit) === targetRoleId
+  );
+  if (hasRole && hasRegistry) return;
+
+  const scopedRoot = `parts/by-role/${characterId}/${runtimePathUnitSegment(unit)}`;
+  const roleCatalog = await fetchRuntimeMessagePack(
+    resolveRuntimePackageUrl(partSet.baseUrl, `${scopedRoot}/runtime-role-catalog.msgpack.br`)
+  ) as RuntimeRoleCatalog;
+  const roles = validateScopedRoleCatalog(roleCatalog, characterId, unit);
+  if (partSet.masterVersion && partSet.masterVersion !== roleCatalog.masterVersion) {
+    throw new Error(
+      `Cross-role registry version mismatch: ${partSet.masterVersion} != ${roleCatalog.masterVersion}.`
+    );
+  }
+  const registryInput = await fetchRuntimeMessagePack(
+    withRuntimeMasterVersion(
+      resolveRuntimePackageUrl(partSet.baseUrl, `${scopedRoot}/part-registry.msgpack.br`),
+      roleCatalog.masterVersion
+    )
+  ) as PartRegistryInput;
+  const registry = normalizePartRegistry(registryInput);
+  if (!hasRole) partSet.roles.push(...roles);
+  if (!hasRegistry) partSet.registry.push(...registry);
+}
