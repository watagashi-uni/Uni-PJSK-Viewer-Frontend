+  const activeRole = { characterId: 2, unit: "light_sound" };
+  const activeEntry = { ...activeRole, costume3dId: 100, partType: "body", packagePath: "original/active" };
+  const foreignRole = {
+    roleId: 5, characterId: 5, unit: "idol", bodyCostume3dId: 500,
+    headCostume3dId: 105, hairCostume3dId: 205,
+    roleRuntimePath: "roles/5/idol/role-runtime.msgpack.br",
+  };
+  const foreignEntry = { ...foreignRole, costume3dId: 500, partType: "body", packagePath: "original/foreign", status: "ready" };
+  const partSet = () => ({
+    baseUrl: "https://viewer.test/original-store/", masterVersion: "same-version",
+    roles: [activeRole], registry: [activeEntry], packages: new Map(), roleRuntimes: new Map(), compatibility: null,
+  });
+  globalThis.fetch = async (input) => {
+    const url = new URL(String(input));
+    if (url.pathname.endsWith(".wasm")) {
+      return new Response(await readFile(new URL("../node_modules/brotli-wasm/pkg.web/brotli_wasm_bg.wasm", import.meta.url)), { headers: { "Content-Type": "application/wasm" } });
+    }
+    requests.push(url);
+    const value = url.pathname.endsWith("runtime-role-catalog.msgpack.br")
+      ? { version: 2, masterVersion: "same-version", roles: [foreignRole] }
+      : [foreignEntry];
+    return new Response(brotliCompressSync(encode(value)));
+  };
+  try {
+    const set = partSet();
+    await ensureRolePartRegistry(set, 2, "light_sound");
+    assert.equal(requests.length, 0, "Active-role recipes need no extra catalog request");
+    await ensureRolePartRegistry(set, 5, "idol");
+    assert.equal(requests.length, 2);
+    assert.equal(requests[1].searchParams.get("masterVersion"), "same-version");
+    assert.deepEqual(set.roles, [activeRole, foreignRole]);
+    assert.deepEqual(set.registry, [activeEntry, foreignEntry]);
+    assert.equal(set.packages.size, 0, "Catalog merge must not preload part models");
+    await ensureRolePartRegistry(set, 5, "idol");
+    assert.equal(requests.length, 2, "Merged role catalogs are reused");
+
+    const mismatch = partSet();
+    mismatch.masterVersion = "older-version";
+    await assert.rejects(ensureRolePartRegistry(mismatch, 5, "idol"), /version mismatch/);
+    assert.deepEqual(mismatch.roles, [activeRole]);
+    assert.deepEqual(mismatch.registry, [activeEntry]);
+    assert.equal(requests.length, 3, "A version mismatch stops before fetching the foreign registry");
+  } finally {
+    globalThis.fetch = previousFetch;
+    globalThis.window = previousWindow;
+  }
+});
diff --git a/tests/public-framing-browser.mjs b/tests/public-framing-browser.mjs
new file mode 100644
index 00000000..01f5759f
--- /dev/null
+++ b/tests/public-framing-browser.mjs
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import { chromium } from "playwright";
+import { createServer } from "vite";
+
+const server = await createServer({
+  configFile: false,
+  server: { host: "127.0.0.1", port: 0, hmr: false, watch: null },
+  plugins: [{ name: "public-framing-harness", configureServer(server) {
+    server.middlewares.use("/__framing", (_request, response) => {
+      response.setHeader("Content-Type", "text/html");
+      response.end('<!doctype html><body><canvas id="canvas" width="640" height="640" style="width:640px;height:640px"></canvas></body>');
+    });
+  } }],
+});
+await server.listen();
+const browser = await chromium.launch({
+  executablePath: process.env.CHROMIUM_PATH ?? "/usr/bin/chromium",
+  args: ["--no-sandbox", "--enable-unsafe-swiftshader"],
+});
+const page = await browser.newPage();
+const errors = [];
+page.on("pageerror", error => errors.push(error.message));
+try {
+  await page.goto(`http://127.0.0.1:${server.httpServer.address().port}/__framing`);
+  const snapshots = await page.evaluate(async () => {
+    const { createHaruki3DKernel } = await import("/dist/haruki-3d-engine.js");
+    const { Haruki3DEngineCore } = await import("/dist/haruki-3d-engine-internal.js");
+    // Observe the actual engine created by the public factory, without adding
+    // an inspection method to the production kernel API.
+    const resize = Haruki3DEngineCore.prototype.setViewportSize;
+    let currentEngine;
+    Haruki3DEngineCore.prototype.setViewportSize = function (...args) {
+      currentEngine = this;
+      return resize.apply(this, args);
+    };
+    const result = {};
+    for (const framing of [undefined, "default", "upper-body"]) {
+      const kernel = createHaruki3DKernel({
+        canvas: document.querySelector("canvas"), assetBaseUrl: "/unused-store/",
+        ...(framing ? { framing } : {}),
+      });
+      kernel.resize(640, 640);
+      const initial = currentEngine.getCameraDebugSnapshot();
+      kernel.resize(320, 240);
+      kernel.setViewYawDegrees(45);
+      const resizedAndRotated = currentEngine.getCameraDebugSnapshot();
+      result[framing ?? "omitted"] = { initial, resizedAndRotated };
+      await kernel.destroy();
+    }
+    Haruki3DEngineCore.prototype.setViewportSize = resize;
+    return result;
+  });
+  assert.deepEqual(snapshots.default, snapshots.omitted, "Explicit default must preserve the existing factory camera");
+  assert.equal(snapshots.omitted.initial.preset, "default");
+  assert.equal(snapshots.omitted.initial.profile, null);
+  assert.equal(snapshots.omitted.initial.fovDegrees, 35);
+  const upper = snapshots["upper-body"];
+  assert.equal(upper.initial.preset, "capture", "Use the direct camera, not the full CostumeShop screen composite");
+  assert.equal(upper.initial.profile, "official-default");
+  assert.deepEqual(upper.initial.position, { x: 0, y: 1.25, z: 2.3 });
+  assert.deepEqual(upper.initial.target, { x: 0, y: 1.25, z: 0 });
+  assert.equal(upper.initial.fovDegrees, 25);
+  assert.equal(upper.resizedAndRotated.profile, "official-default", "Resizing and view rotation preserve the selected framing");
+  assert.equal(upper.resizedAndRotated.aspect, 1.3333);
+  assert.equal(upper.resizedAndRotated.fovDegrees, 25);
+  assert.equal(upper.resizedAndRotated.characterRootYawDegrees, 0, "View framing does not rotate the character or disturb physics");
+  assert.deepEqual(errors, []);
+  console.log("PASS: public default framing unchanged; upper-body uses the existing close camera and survives resize/view rotation");
+} finally {
+  await browser.close();
+  await server.close();
+}
